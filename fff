<Window x:Class="demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="950" Width="700">
    <Grid Margin="25">
        <StackPanel>
            <Label Content="Логин" FontWeight="SemiBold"/>
            <TextBox x:Name="LoginTextBox" Height="32" Margin="0,0,0,12" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>

            <Label Content="Пароль" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Height="32" Margin="0,0,0,20" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>

            <GroupBox Header="Капча:" Margin="0,0,0,15">
                <UniformGrid Rows="2" Columns="2" Height="600" Width="600">
                    <Image Source="/Resources/4.png" MouseLeftButtonDown="Captcha1_Click" Cursor="Hand" Margin="5" Stretch="UniformToFill"/>
                    <Image Source="/Resources/2.png" MouseLeftButtonDown="Captcha2_Click" Cursor="Hand" Margin="5" Stretch="UniformToFill"/>
                    <Image Source="/Resources/1.png" MouseLeftButtonDown="Captcha3_Click" Cursor="Hand" Margin="5" Stretch="UniformToFill"/>
                    <Image Source="/Resources/3.png" MouseLeftButtonDown="Captcha4_Click" Cursor="Hand" Margin="5" Stretch="UniformToFill"/>
                </UniformGrid>
            </GroupBox>

            <TextBlock x:Name="txtCaptcha" Text="" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <Button Content="Войти" Height="45" FontSize="16" Click="Login_Click"/>
        </StackPanel>
    </Grid>
</Window>
    
